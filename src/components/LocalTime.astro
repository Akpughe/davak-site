---
// Live clock for David's time zone, plus how far ahead/behind the visitor is.
const timeZone = 'Europe/London';
---

<span class="local-time" data-tz={timeZone}>
  <span class="local-time-dot" aria-hidden="true"></span>
  <time class="local-time-clock">--:--</time>
  <span class="local-time-diff"></span>
</span>

<script>
  function wallClockMinutes(date: Date, timeZone?: string) {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone,
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
    }).formatToParts(date);
    const get = (type: string) => Number(parts.find((p) => p.type === type)?.value);
    return Date.UTC(get('year'), get('month') - 1, get('day'), get('hour'), get('minute')) / 60000;
  }

  function describeDiff(minutes: number) {
    if (minutes === 0) return 'same time as you';
    const abs = Math.abs(minutes);
    const h = Math.floor(abs / 60);
    const m = abs % 60;
    const span = m ? `${h ? `${h}h ` : ''}${m}m` : `${h}h`;
    return `${span} ${minutes > 0 ? 'ahead of' : 'behind'} you`;
  }

  function status(hour: number, day: number) {
    if (hour < 7 || hour >= 23) return 'probably asleep';
    if (day === 0 || day === 6) return 'weekend';
    if (hour < 9) return 'morning coffee';
    if (hour < 19) return 'probably building';
    return 'winding down';
  }

  let timer: number | undefined;

  function init() {
    const el = document.querySelector<HTMLElement>('.local-time');
    if (!el) return;
    const tz = el.dataset.tz!;
    const clock = el.querySelector('time')!;
    const diff = el.querySelector('.local-time-diff')!;

    const tick = () => {
      const now = new Date();
      const there = new Intl.DateTimeFormat('en-GB', {
        timeZone: tz, hour: '2-digit', minute: '2-digit', weekday: 'short', hourCycle: 'h23',
      }).formatToParts(now);
      const hour = Number(there.find((p) => p.type === 'hour')?.value);
      const minute = there.find((p) => p.type === 'minute')?.value;
      const weekday = there.find((p) => p.type === 'weekday')?.value ?? '';
      const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(weekday);

      clock.innerHTML = `${String(hour).padStart(2, '0')}<span class="local-time-colon">:</span>${minute}`;
      clock.dateTime = now.toISOString();
      diff.textContent = `in London, ${describeDiff(wallClockMinutes(now, tz) - wallClockMinutes(now))} · ${status(hour, day)}`;
      el.dataset.awake = String(hour >= 7 && hour < 23);
    };

    tick();
    clearInterval(timer);
    timer = window.setInterval(tick, 1000);
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .local-time { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0 6px; color: var(--muted); }
  .local-time-dot { width: 6px; height: 6px; border-radius: 50%; background: #22c55e; align-self: center; box-shadow: 0 0 0 0 rgb(34 197 94 / 0.5); animation: pulse 2.4s ease-out infinite; }
  .local-time[data-awake='false'] .local-time-dot { background: var(--muted); animation: none; }
  .local-time-clock { color: var(--foreground); font-variant-numeric: tabular-nums; }
  :global(.local-time-colon) { animation: blink 1s steps(2, start) infinite; }

  @keyframes pulse {
    to { box-shadow: 0 0 0 6px rgb(34 197 94 / 0); }
  }
  @keyframes blink {
    to { visibility: hidden; }
  }
</style>
