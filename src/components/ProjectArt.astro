---
// Deterministic generative dot field, seeded by the project title.
export interface Props {
  seed: string;
}

const { seed } = Astro.props;

function hash(text: string) {
  let h = 2166136261;
  for (const char of text) {
    h ^= char.charCodeAt(0);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const h = hash(seed);
const variant = h % 4;
const fx = 0.25 + ((h >> 4) % 100) / 200;
const fy = 0.2 + ((h >> 12) % 100) / 220;
const phase = ((h >> 20) % 628) / 100;

const cols = 20;
const rows = 12;
const step = 16;

const dots = [];
for (let y = 0; y < rows; y++) {
  for (let x = 0; x < cols; x++) {
    const nx = x / cols - 0.5;
    const ny = y / rows - 0.5;
    let v: number;
    if (variant === 0) v = Math.sin(x * fx + phase) * Math.cos(y * fy * 1.6 + phase);
    else if (variant === 1) v = Math.cos(Math.hypot(nx * 1.6, ny) * (10 + fx * 10) - phase);
    else if (variant === 2) v = Math.sin((x + y * 1.3) * fx + phase) * 0.8 + Math.cos(y * fy) * 0.2;
    else v = Math.sin(Math.atan2(ny, nx) * 3 + phase) * Math.cos(Math.hypot(nx, ny) * 8);
    const r = Math.max(0.35, ((v + 1) / 2) * 3.2);
    dots.push({ cx: step / 2 + x * step, cy: step / 2 + y * step, r: r.toFixed(2), d: (x + y) * 18 });
  }
}
---

<svg class="project-art" viewBox={`0 0 ${cols * step} ${rows * step}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {dots.map((dot) => <circle cx={dot.cx} cy={dot.cy} r={dot.r} style={`--d:${dot.d}ms`} />)}
</svg>

<style>
  .project-art { position: absolute; inset: 0; width: 100%; height: 100%; fill: currentColor; color: var(--muted); opacity: 0.55; }
  circle { transform-box: fill-box; transform-origin: center; transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1); transition-delay: var(--d); }
  :global(.project-image-wrap:hover) .project-art circle { transform: scale(1.6); }
</style>
