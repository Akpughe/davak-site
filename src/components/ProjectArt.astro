---
import { dotField } from '../lib/dot-art';

export interface Props {
  seed: string;
}

const { dots, width, height } = dotField(Astro.props.seed);
---

<svg class="project-art" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {dots.map((dot) => <circle cx={dot.cx} cy={dot.cy} r={dot.r} style={`--d:${dot.d}ms`} />)}
</svg>

<style>
  .project-art { position: absolute; inset: 0; width: 100%; height: 100%; fill: currentColor; color: var(--muted); opacity: 0.55; }
  circle { transform-box: fill-box; transform-origin: center; transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1); transition-delay: var(--d); }
  :global(.project-image-wrap:hover) .project-art circle { transform: scale(1.6); }
</style>
