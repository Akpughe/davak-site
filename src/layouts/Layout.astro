---
import { ClientRouter } from 'astro:transitions';
import CommandMenu from '../components/CommandMenu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

import { SITE_URL, profile } from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  ogImage?: string;
  breadcrumbs?: { name: string; path: string }[];
  published?: string;
  updated?: string;
  // Article extras: the product the article is about, and indexing hints.
  about?: { name: string; url: string; description: string; category?: string; os?: string; isNuton?: boolean };
  keywords?: string[];
  words?: number;
  minutes?: number;
}

const {
  title,
  description = 'David Akpughe — AI/ML product engineer building AI systems and learning products.',
  type = 'website',
  ogImage = '/og/index.png',
  breadcrumbs,
  published,
  updated,
  about,
  keywords,
  words,
  minutes,
} = Astro.props;
const siteUrl = Astro.site ?? new URL(SITE_URL);
const abs = (path: string) => new URL(path, siteUrl).toString();
// Match the sitemap's directory URLs, including visits without a trailing slash.
const pagePath = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonicalUrl = abs(pagePath);
const isProfilePage = pagePath === '/' || pagePath === '/about/';
const imageUrl = abs(ogImage);
const personId = `${abs('/')}#person`;
const nutonId = `${abs('/')}#nuton`;
const portraitId = `${abs('/')}#portrait`;
const completedEducation = profile.education.filter((education) => education.completed);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      url: abs('/'),
      jobTitle: profile.jobTitle,
      description: profile.summary,
      image: { '@id': portraitId },
      mainEntityOfPage: { '@id': `${abs('/about/')}#webpage` },
      email: `mailto:${profile.email}`,
      homeLocation: { '@type': 'Country', name: profile.location },
      worksFor: { '@id': nutonId },
      alumniOf: completedEducation.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
      hasCredential: completedEducation.map((e) => ({ '@type': 'EducationalOccupationalCredential', name: e.degree })),
      knowsAbout: profile.knowsAbout,
      sameAs: [profile.links.linkedin, profile.links.github, profile.links.substack, profile.links.substackBlog],
    },
    {
      '@type': 'ImageObject',
      '@id': portraitId,
      url: abs(profile.image),
      contentUrl: abs(profile.image),
      caption: profile.name,
      about: { '@id': personId },
    },
    {
      '@type': 'Organization',
      '@id': nutonId,
      name: profile.current.org,
      url: profile.current.url,
      description: 'AI-powered learning platform that turns YouTube videos and documents into courses, quizzes, flashcards, and podcasts.',
      founder: { '@id': personId },
    },
    {
      '@type': 'WebSite',
      '@id': `${abs('/')}#website`,
      url: abs('/'),
      name: 'davak.site',
      alternateName: ['Davak', profile.name],
      inLanguage: 'en-GB',
      publisher: { '@id': personId },
    },
    type === 'article'
      ? {
          '@type': 'TechArticle',
          '@id': `${canonicalUrl}#article`,
          url: canonicalUrl,
          headline: title,
          description,
          image: imageUrl,
          inLanguage: 'en-GB',
          author: { '@id': personId },
          publisher: { '@id': personId },
          isPartOf: { '@id': `${abs('/')}#website` },
          mainEntityOfPage: canonicalUrl,
          about: about?.isNuton
            ? { '@id': nutonId }
            : about
              ? {
                  '@type': 'SoftwareApplication',
                  name: about.name,
                  url: about.url,
                  description: about.description,
                  applicationCategory: about.category ?? 'WebApplication',
                  operatingSystem: about.os ?? 'Web',
                  creator: { '@id': personId },
                }
              : { '@id': nutonId },
          ...(keywords?.length ? { keywords: keywords.join(', ') } : {}),
          ...(words ? { wordCount: words } : {}),
          ...(minutes ? { timeRequired: `PT${minutes}M` } : {}),
          ...(published ? { datePublished: published } : {}),
          ...(updated ?? published ? { dateModified: updated ?? published } : {}),
        }
      : {
          '@type': isProfilePage ? 'ProfilePage' : 'WebPage',
          '@id': `${canonicalUrl}#webpage`,
          url: canonicalUrl,
          name: title,
          description,
          inLanguage: 'en-GB',
          isPartOf: { '@id': `${abs('/')}#website` },
          ...(isProfilePage
            ? { mainEntity: { '@id': personId }, primaryImageOfPage: { '@id': portraitId } }
            : {}),
        },
    ...(breadcrumbs?.length
      ? [{
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumbs.map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: crumb.name,
            item: abs(crumb.path),
          })),
        }]
      : []),
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="davak.site" />
    <meta name="application-name" content="davak.site" />
    <meta name="apple-mobile-web-app-title" content="davak.site" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    {type === 'article' && (updated ?? published) && <meta property="article:modified_time" content={updated ?? published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <title>{title}</title>
    {keywords?.length && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
    <link rel="me" href={profile.links.github} />
    <link rel="me" href={profile.links.linkedin} />
    <link rel="me" href={profile.links.substack} />
    <link rel="me" href={profile.links.substackBlog} />
    <script is:inline>
      (function () {
        function apply(doc) {
          var stored;
          try { stored = localStorage.getItem('theme'); } catch (e) {}
          var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          doc.documentElement.dataset.theme = dark ? 'dark' : 'light';
        }
        apply(document);
        document.addEventListener('astro:before-swap', function (e) { apply(e.newDocument); });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <main>
      <div class="site-tools">
        <CommandMenu />
        <ThemeToggle />
      </div>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
