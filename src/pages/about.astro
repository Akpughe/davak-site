---
import Layout from '../layouts/Layout.astro';
import { profile } from '../lib/site';
import { articlesOf, getProjects } from '../lib/projects';

const all = await getProjects();
const guides = articlesOf(all);
const products = all.filter((p) => p.data.kind === 'product');
---

<Layout
  title="About David Akpughe — AI/ML Product Engineer"
  description={profile.summary}
  ogImage="/og/about.png"
  breadcrumbs={[
    { name: 'David Akpughe', path: '/' },
    { name: 'About', path: '/about/' },
  ]}
>
  <article class="project-detail">
    <div class="page-header">
      <a href="/">← David Akpughe</a>
    </div>

    <h1>About</h1>

    <div class="project-content">
      <p>{profile.summary}</p>

      <h2>Experience</h2>
      <ul>
        {profile.experience.map((job) => (
          <li>
            <strong>{job.role}</strong>,{' '}
            {job.url ? <a href={job.url} target="_blank" rel="noopener">{job.org}</a> : job.org}
            {job.note ? ` (${job.note})` : ''}{job.location ? `, ${job.location}` : ''} · {job.period}. {job.summary}
          </li>
        ))}
      </ul>

      <h2>Education</h2>
      <ul>
        {profile.education.map((e) => <li>{e.degree}, {e.school} ({e.period})</li>)}
      </ul>
      <p>Based in the {profile.location}.</p>

      <h2>Products</h2>
      <ul>
        {products.map((p) => <li><a href={p.data.link} target="_blank" rel="noopener">{p.data.title}</a>: {p.data.summary}</li>)}
      </ul>

      <h2>What I work on</h2>
      <p>
        I build AI systems that hold up in production: retrieval pipelines that work on messy real-world documents,
        generation that stays grounded in its sources, and the product around them that people actually use.
        At Nuton that means the RAG engine behind course generation, AI Blackboard (a live voice tutor that draws as it teaches),
        and the tools schools use to create lesson plans and notes. Outside Nuton I build open-source agent memory (UltraMem),
        mobile fintech (Kova), and side projects like Cooglr.
      </p>

      <h2>Technical write-ups</h2>
      <ul>
        {guides.map((g) => <li><a href={`${g.data.page}/`}>{g.data.title}</a>: {g.data.description}</li>)}
      </ul>

      <h2>Get in touch</h2>
      <p>
        Email <a href={`mailto:${profile.email}`}>{profile.email}</a>, <a href={profile.links.cal} target="_blank" rel="noopener">book a call</a>,
        or find me on <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>,
        <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>, and
        <a href={profile.links.substack} target="_blank" rel="noopener">Substack</a>.
      </p>
    </div>
  </article>

  <footer class="footer">© {new Date().getFullYear()} David Akpughe</footer>
</Layout>
