---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import LocalTime from '../components/LocalTime.astro';
import ProjectArt from '../components/ProjectArt.astro';
import LinkIcon from '../components/LinkIcon.astro';
import { profile } from '../lib/site';
import { articlesFor, articlesOf, getProjects, headlineOf, hostOf, readingMinutes } from '../lib/projects';

const all = await getProjects();
const products = all.filter((p) => p.data.kind === 'product');
const articles = articlesOf(all);
const clients = all.filter((p) => p.data.kind === 'client');

function excerpt(text: string, wordLimit = 26) {
  const words = text.trim().split(/\s+/);
  return words.length > wordLimit ? `${words.slice(0, wordLimit).join(' ')}…` : text.trim();
}
const summaryOf = (p: (typeof all)[number]) => p.data.summary ?? excerpt(p.body ?? '');
const productFor = (p: (typeof all)[number]) => all.find((x) => x.id.replace(/\.md$/, '') === p.data.product);

const keyOf = (label: string) => label.toLowerCase().replace(/\s+/g, '-');
// Filter keys for a product card: its status, plus Web or Mobile from where it runs.
const filtersOf = (p: (typeof all)[number]) => {
  const platforms = p.data.platforms ?? [];
  return [
    p.data.status && keyOf(p.data.status),
    platforms.some((x) => x === 'Web' || x === 'Chrome extension') && 'web',
    platforms.some((x) => x === 'iOS' || x === 'Android') && 'mobile',
  ].filter((k): k is string => Boolean(k));
};
const filters = [
  { key: 'all', label: 'All', count: products.length },
  ...['Live', 'Web', 'Mobile', 'Open source', 'In development'].map((label) => ({
    key: keyOf(label),
    label,
    count: products.filter((p) => filtersOf(p).includes(keyOf(label))).length,
  })),
].filter((f) => f.count > 0);
---


<Layout
  title="David Akpughe — AI/ML Product Engineer"
  description="David Akpughe is an AI/ML product engineer and co-founder of Nuton. Products, experience, and technical write-ups on RAG, agent memory, and AI tutoring."
>
  <section class="hero">
    <div class="hero-copy">
      <h1>David Akpughe</h1>
      <ul class="hero-bio">
        <li>AI/ML Product Engineer</li>
        <li>Co-founder, Nuton — AI-powered learning platform</li>
        <li>Previously Full-Stack Engineer at ChowCentral (YC S23) and Autochek Africa</li>
        <li>MSc Artificial Intelligence, Wrexham University (in progress); Honours BSc Computer Science, Babcock University</li>
        <li>Building AI systems that simplify complexity and create real impact</li>
        <li>Based in the United Kingdom<br /><LocalTime /></li>
      </ul>
      <nav class="socials" aria-label="Social links">
      <a href="https://www.linkedin.com/in/david-akpughe-392241103/" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="https://github.com/Akpughe" target="_blank" rel="noopener" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <a href="https://substack.com/@davak01" target="_blank" rel="noopener" aria-label="Substack">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.81H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
      </a>
      <a href="mailto:davidakpughe2@gmail.com" aria-label="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
      </a>
      <a href="https://cal.com/david-akpughe-igoy5i/15min" target="_blank" rel="noopener" aria-label="Book a call">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V9h14v10zM5 7V5h14v2H5z"/></svg>
      </a>
      <a href="/resume.pdf" target="_blank" aria-label="Resume">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
      </a>
      </nav>
      <p class="nav-links">
        <a href="/about">About</a> · <a href="#experience-heading">Experience</a> · <a href="#products-heading">Products</a> · <a href="/writing">Writing</a>
      </p>
    </div>
    <div class="portrait">
      <picture>
        <source srcset="/images/david.webp" type="image/webp" />
        <img src="/images/david-640.jpg" alt="David Akpughe" width="512" height="640" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <section class="work-section" aria-labelledby="experience-heading">
    <h2 class="section-heading" id="experience-heading">Experience</h2>
    <ol class="experience-list">
      {profile.experience.map((job) => (
        <li class="experience-item">
          <p class="experience-period">{job.period}</p>
          <div>
            <h3 class="experience-role">
              {job.role},{' '}
              {job.url ? <a href={job.url} target="_blank" rel="noopener">{job.org}</a> : job.org}
              {job.note && <span class="experience-note"> ({job.note})</span>}
              {job.location && <span class="experience-note"> · {job.location}</span>}
            </h3>
            <p class="experience-summary">{job.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="work-section" aria-labelledby="products-heading">
    <h2 class="section-heading" id="products-heading">Products</h2>
    <p class="section-links">Things I have built that you can use today. Each links to the live product, and to a write-up where there is one.</p>
    <div class="product-filter" role="group" aria-label="Filter products">
      {filters.map((f) => (
        <button type="button" class={`chip chip-${f.key}`} data-filter={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>
          {f.label} <span class="chip-count">{f.count}</span>
        </button>
      ))}
    </div>
  </section>
  <div class="project-grid" aria-live="polite">
    {products.map((project) => {
      const writeups = articlesFor(project, all);
      return (
        <article class="project-card" data-filters={filtersOf(project).join(' ')}>
          <a href={project.data.link} target="_blank" rel="noopener" class="project-image-wrap" tabindex="-1" aria-hidden="true">
            {project.data.cover ? (
              <Image class="project-cover" src={project.data.cover} alt="" widths={[360, 720]} sizes="(min-width: 1024px) 230px, (min-width: 640px) 45vw, 90vw" />
            ) : (
              <div class="project-image-placeholder">
                <ProjectArt seed={project.data.title} />
                <span class="project-mark">{project.data.title.slice(0, 1)}</span>
                <span>{project.data.title}</span>
              </div>
            )}
          </a>
          <div class="product-head">
            <h3 class="project-title">
              <a href={project.data.link} target="_blank" rel="noopener">{project.data.title}</a>
            </h3>
            {project.data.status && <span class={`status chip-${keyOf(project.data.status)}`}>{project.data.status}</span>}
          </div>
          <p class="product-meta">
            {(project.data.platforms ?? []).map((p) => <span class={`chip chip-${keyOf(p)}`}>{p}</span>)}
            <span class="product-year">{project.data.date}</span>
          </p>
          <p class="project-desc">{summaryOf(project)}</p>
          <div class="product-footer">
            <p class="product-links">
              <a class="product-open" href={project.data.link} target="_blank" rel="noopener">
                {project.data.status === 'Open source' ? (
                  <><LinkIcon name="github" /><span>View on GitHub</span></>
                ) : (
                  <>{project.data.status === 'Live' && <LinkIcon name="live" />}<span>Open {hostOf(project.data.link)}</span></>
                )}
                <LinkIcon name="arrow" />
              </a>
              {project.data.links?.filter((l) => l.card).map((l) => (
                <a href={l.url} target="_blank" rel="noopener">
                  {hostOf(l.url) === 'github.com' && <LinkIcon name="github" />}
                  <span>{l.label}</span>
                  <LinkIcon name="arrow" />
                </a>
              ))}
            </p>
            {writeups.length > 0 && (
              <p class="product-read">
                <span>Read</span>
                {writeups.map((w) => (
                  <a href={`${w.data.page}/`}>{w.data.label ?? (w === project ? 'How it’s built' : w.data.title)}</a>
                ))}
              </p>
            )}
          </div>
        </article>
      );
    })}
  </div>

  <section class="work-section" aria-labelledby="writeups-heading">
    <h2 class="section-heading" id="writeups-heading">Technical write-ups</h2>
    <p class="section-links">Long-form articles on how these products are built. Essays live on <a href="/writing">Writing</a>.</p>
    <ul class="writeup-list">
      {articles.map((a) => {
        const product = a.data.kind === 'writeup' ? productFor(a) : a;
        return (
          <li class="writeup-item">
            <a class="writeup-title" href={`${a.data.page}/`}>{headlineOf(a)}</a>
            <p class="writeup-desc">{a.data.description}</p>
            <p class="writeup-meta">
              <span class="tag">Write-up</span> {readingMinutes(a.body)} min read
              {product && <> · About <a href={product.data.link} target="_blank" rel="noopener">{product.data.title} ↗</a></>}
            </p>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="work-section" aria-labelledby="clients-heading">
    <h2 class="section-heading" id="clients-heading">Client work</h2>
    <ul class="client-list">
      {clients.map((c) => (
        <li>
          <a href={c.data.link} target="_blank" rel="noopener">{c.data.title} ↗</a>
          <span>{c.data.date} · {summaryOf(c)}</span>
        </li>
      ))}
    </ul>
  </section>

  <footer class="footer">
    © {new Date().getFullYear()} David Akpughe
  </footer>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.product-filter [data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.project-card[data-filters]');

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const filter = button.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach((card) => {
        card.hidden = filter !== 'all' && !card.dataset.filters!.split(' ').includes(filter);
      });
    }),
  );
</script>
